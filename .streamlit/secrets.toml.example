# RankAlpha — Streamlit secrets template.
#
# LOCAL: copy this file to `.streamlit/secrets.toml` (gitignored) and paste your key.
# HOSTED (Streamlit Community Cloud): do NOT commit this — paste the same line into the
# app's  Settings ▸ Secrets  box in the Streamlit Cloud dashboard instead.
#
# When GROQ_API_KEY is present the LLM explainer uses Groq; otherwise it falls back to the
# deterministic template (the app always works without a key). Get a free key at
# https://console.groq.com/keys

GROQ_API_KEY = "gsk_your_key_here"

# Optional — override the default Groq model (default: llama-3.1-8b-instant)
# GROQ_MODEL = "llama-3.1-8b-instant"
